# Build config for the Capacitor (mobile) bundle.
# Inside the native WebView the page origin is the app itself, not the
# website — so the API/Socket.IO base URL must point explicitly at the
# deployed backend. Used only by `npm run build:mobile` (vite --mode mobile);
# the regular web build is unaffected.
VITE_BACKEND_URL=https://agriapp-mhbz.onrender.com

# Native push. Leave false until Firebase is wired into android/ (google-services.json
# + Gradle plugin) — calling PushNotifications.register() without it crashes the
# Android app. Flip to true once configured. See MOBILE.md.
VITE_ENABLE_PUSH=false
