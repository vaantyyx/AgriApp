# Server Configuration
PORT=3001
JWT_SECRET=
MONGODB_URI=mongodb://127.0.0.1:27017/agriapp

# Redis — required for rate limiting, CAPTCHA challenge storage, and the
# Socket.IO adapter that keeps real-time auction updates in sync across
# multiple backend instances behind a load balancer.
REDIS_URL=redis://127.0.0.1:6379

# Comma-separated list of origins allowed to call this API / connect via Socket.IO.
# Defaults to local dev origins (localhost:5173/5174) when unset.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Email SMTP Configuration
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Sougra

# App URLs
APP_URL=http://localhost:5173
