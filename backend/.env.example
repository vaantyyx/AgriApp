# Server Configuration
PORT=3001
# Interface to bind to. Defaults to 0.0.0.0 (all interfaces) so the app is reachable
# once deployed; set to 127.0.0.1 to restrict to local-only access (e.g. behind a
# reverse proxy on the same host).
HOST=0.0.0.0
# Set to "production" on deployed environments — disables verbose dev-only logging
# (OTP codes, email verification/reset links printed to console and email_dev.log).
NODE_ENV=development
JWT_SECRET=
MONGODB_URI=mongodb://127.0.0.1:27017/agriapp
# Optional. When set, Socket.IO uses the Redis adapter so state (rooms,
# broadcasts) is shared across multiple server instances. Safe to leave unset
# for a single-instance deployment — falls back to in-memory automatically.
REDIS_URL=
# Set to 1 only when running behind a reverse proxy / load balancer (Nginx,
# a cloud LB) — tells Express to trust its X-Forwarded-* headers so
# rate-limiting keys off the real visitor IP instead of the proxy's own IP.
# Leave unset for direct/local deployments with no proxy in front.
TRUST_PROXY=

# Comma-separated list of origins allowed to call this API / connect via Socket.IO.
# Defaults to local dev origins (localhost:5173/5174) when unset.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Email — emailService.js tries these in order and uses the first one fully
# configured: EmailJS, then Brevo's API, then plain SMTP below. Leave a
# provider's vars unset to skip it and fall through to the next.
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
BREVO_API_KEY=
# SMTP fallback (used only if neither EmailJS nor Brevo above is configured)
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Sougra

# App URLs
APP_URL=http://localhost:5173

# AI Assistant (header chat widget) — Groq API key (free tier, no billing
# required), get one at https://console.groq.com/keys. Leave unset to disable
# the assistant (the frontend button still shows but requests fail with a clear error).
GROQ_API_KEY=
# Optional: override the default chat model.
GROQ_MODEL=llama-3.3-70b-versatile

# File storage (profile photos, RC/legal documents) — Cloudinary free tier,
# get credentials at https://cloudinary.com/users/register/free. STRONGLY
# RECOMMENDED in production: leaving these unset falls back to writing files
# to local disk, which is lost on every redeploy/restart on hosts with an
# ephemeral filesystem (Render and most PaaS free tiers).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Error tracking (optional) — Sentry DSN, get one at https://sentry.io.
# Leave unset to disable; the app runs normally without it.
SENTRY_DSN=
