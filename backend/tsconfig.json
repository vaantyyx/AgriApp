{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "strict": false,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": ["**/*.js", "types/**/*.d.ts"],
  "exclude": ["node_modules"]
}
